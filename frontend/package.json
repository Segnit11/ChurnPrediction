{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.7.7",
    "chart.js": "^4.4.8",
    "framer-motion": "^11.11.17",
    "html-react-parser": "^5.2.2",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "react-gauge-chart": "^0.4.1",
    "react-hook-form": "^7.52.1",
    "react-scripts": "^5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "tailwind:build": "tailwindcss -i ./src/styles/tailwind.css -o ./src/styles/output.css --minify",
    "tailwind:watch": "tailwindcss -i ./src/styles/tailwind.css -o ./src/styles/output.css --watch",
    "prestart": "npm run tailwind:build",
    "start": "concurrently -k -n CSS,APP -c magenta,cyan \"npm:tailwind:watch\" \"react-scripts start\"",
    "prebuild": "npm run tailwind:build",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@tailwindcss/cli": "^4.3.1",
    "@tailwindcss/postcss": "^4.0.15",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^10.0.0",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.15",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  }
}
